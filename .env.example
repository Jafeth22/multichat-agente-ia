# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zernio API key, Resend y las keys de IA BYOK (OpenAI/Anthropic/Google) se
# configuran desde /dashboard/settings/integrations y se guardan cifradas en
# Supabase Vault, nunca en variables de entorno. La key de AI Gateway (para
# el nodo "AI Response" del flow builder) se configura en Settings general.

# AI Gateway (for AI Response flow node, optional for self-hosted)
# On Vercel: configure provider keys in AI Gateway settings (automatic OIDC auth)
# Self-hosted: set this key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=your-gateway-key

# Cron secret (for sequence processor + job scheduler)
CRON_SECRET=your-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Evolution API (WhatsApp/Baileys), desplegado en Railway como servicio
# aparte. Como la app corre en Vercel (no en Railway), no comparten red
# privada: usa la URL publica que te da Railway para ese servicio, con
# HTTPS (ej: https://evolution-api-production.up.railway.app). La API key
# es la que configuraste al desplegar Evolution API (variable
# AUTHENTICATION_API_KEY de Evolution) — usa una bien larga y unica, es lo
# unico que protege ese servicio al quedar expuesto a internet.
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=your-evolution-api-key
